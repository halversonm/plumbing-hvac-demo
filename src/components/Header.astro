---
const { current = "" } = Astro.props;

const links = [
	{ href: "/", label: "Home" },
	{ href: "/services", label: "Services" },
	{ href: "/about", label: "About" },
	{ href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50">
	<input type="checkbox" id="menu-toggle" class="peer hidden" />
	<div class="bg-ink text-white">
		<div class="mx-auto max-w-6xl px-6 flex items-center justify-between gap-4 py-3">
			<a class="flex items-center gap-2.5" href="/">
				<svg class="h-11 w-11 flex-shrink-0" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
					<rect width="40" height="40" rx="7" fill="#C1552A" />
					<path d="M13 26.5c0-4 3-6 3-10a4 4 0 0 1 8 0c0 4 3 6 3 10a7 7 0 0 1-14 0Z" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round"/>
					<path d="M17 26.5a3 3 0 0 0 6 0" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
				</svg>
				<span class="flex flex-col leading-tight">
					<span class="font-head font-extrabold text-xl uppercase text-white tracking-wide">Ironwood</span>
					<span class="text-[0.68rem] uppercase tracking-wider text-primary font-bold">Plumbing · Heating · Cooling</span>
				</span>
			</a>

			<ul class="hidden md:flex items-center gap-7">
				{links.map((link) => (
					<li>
						<a
							href={link.href}
							aria-current={current === link.href ? "page" : undefined}
							class="font-bold text-sm uppercase tracking-wide text-white/80 hover:text-primary transition-colors aria-[current=page]:text-primary"
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>

			<div class="flex items-center gap-2.5">
				<a class="hidden lg:inline-flex items-center gap-2 rounded-md border-2 border-white/70 px-4 py-2.5 text-xs font-bold uppercase tracking-wide text-white hover:border-primary hover:text-primary transition">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
					Schedule
				</a>
				<a href="/contact" class="hidden md:inline-flex items-center gap-2 rounded-md border-2 border-white/70 px-4 py-2.5 text-xs font-bold uppercase tracking-wide text-white hover:border-primary hover:text-primary transition">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
					Estimate
				</a>
				<a href="tel:+15552147890" class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2.5 text-xs font-bold uppercase tracking-wide text-white hover:bg-primary-dark transition">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
					Call Us
				</a>
				<label for="menu-toggle" class="md:hidden flex items-center justify-center h-10 w-10 rounded-md border-2 border-white/70 cursor-pointer">
					<svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<line x1="3" y1="6" x2="21" y2="6"/>
						<line x1="3" y1="12" x2="21" y2="12"/>
						<line x1="3" y1="18" x2="21" y2="18"/>
					</svg>
				</label>
			</div>
		</div>
	</div>

	<div class="bg-white border-b border-border">
		<div class="mx-auto max-w-6xl px-6 flex items-center justify-center sm:justify-start gap-2.5 py-2 text-sm">
			<svg class="h-5 w-5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
			<span class="font-bold text-star">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
			<span class="font-extrabold">4.9</span>
			<span class="text-ink-soft">312 Google Reviews</span>
			<span class="hidden sm:inline text-ink-soft">&middot; Serving Maple Grove &amp; nearby towns since 1998</span>
		</div>
	</div>

	<div class="md:hidden fixed inset-y-0 right-0 z-40 w-72 max-w-[80vw] translate-x-full bg-white shadow-2xl transition-transform duration-300 peer-checked:translate-x-0 pt-24 px-7 pb-7">
		<ul class="flex flex-col gap-5">
			{links.map((link) => (
				<li>
					<a href={link.href} class="text-lg font-bold uppercase text-ink">{link.label}</a>
				</li>
			))}
			<li class="pt-4">
				<a href="/contact" class="inline-flex w-full items-center justify-center rounded-md border-2 border-ink px-5 py-3 text-sm font-bold uppercase text-ink">
					Get a Free Quote
				</a>
			</li>
		</ul>
	</div>
	<label for="menu-toggle" class="md:hidden fixed inset-0 z-30 hidden peer-checked:block bg-ink/40"></label>
</header>
